# Copy this file to .env (in the same directory as SKILL.md, or wherever
# you run the skill from) and fill in real values. Never commit the real
# .env to git.

# Your Send-to-Kindle email address, found at:
# Amazon > Manage Your Content and Devices > Devices > [your Kindle]
KINDLE_EMAIL=[EMAIL]

# SMTP account used to send the email. Gmail example shown — if using
# Gmail, SMTP_PASS must be an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=[SMTP_PORT]
SMTP_USER=[EMAIL]
SMTP_PASS=[SMTP_PASS]
# SMTP_FROM=you@gmail.com   # optional, defaults to SMTP_USER if unset

# IMPORTANT: Amazon only delivers mail from senders on your account's
# approved list. Add SMTP_FROM (or SMTP_USER) at:
# Amazon > Manage Your Content and Devices > Preferences >
# Personal Document Settings > Approved Personal Document E-mail List
