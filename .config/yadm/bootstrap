#!/bin/bash
set -e

# Oh My Zsh
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# Oh My Zsh plugins/themes
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
[ -d "$ZSH_CUSTOM/plugins/fast-syntax-highlighting" ] ||
  git clone https://github.com/zdharma-continuum/fast-syntax-highlighting.git "$ZSH_CUSTOM/plugins/fast-syntax-highlighting"

# iris shell autocomplete
command -v iris >/dev/null 2>&1 ||
  curl -sSL https://raw.githubusercontent.com/versenilvis/iris/main/scripts/install.sh | sh

# Claude Agent AI assistant
curl -fsSL https://claude.ai/install.sh | bash

# Hermes Agent AI assistant
command -v hermes >/dev/null 2>&1 ||
  curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash

# Homebrew packages
brew bundle --file="$HOME/.Brewfile"
